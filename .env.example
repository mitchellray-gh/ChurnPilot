# Example environment variables for local testing (do NOT commit secrets)
# SCRAPE_SOURCES should be a JSON string describing sources (be careful with quoting)
# Example: SCRAPE_SOURCES='[{"id":"example","url":"https://example.com/offers","selectors":{"title":".offer-title","payout":".offer-payout"}}]'

SCRAPE_SOURCES=
SCRAPER_ADMIN_KEY=changeme

# News feed settings
# Refresh interval in seconds (default: 900 = 15 minutes)
NEWS_REFRESH_INTERVAL=900

# Optional: Override default feed sources (JSON array)
# NEWS_FEED_SOURCES='[{"id":"custom","name":"My Feed","url":"https://example.com/rss","category":"bank_account"}]'
NEWS_FEED_SOURCES=
